er-win">
.cf-win {
  grid-area: 1 / 1;
  transition:
    opacity 300ms cubic-bezier(0.2, 0.7, 0.2, 1),
    transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1),
    color 150ms ease-out;
}
.cf-win[data-state='active'] {
  opacity: 1;
  transform: translateY(0);
}
.cf-win[data-state='leaving'],
.cf-win[data-state='waiting'] {
  opacity: 0;
  pointer-events: none;
  transition-duration: 170ms, 170ms, 150ms;
  transition-timing-function: cubic-bezier(0.4, 0, 1, 1);
}
.cf-win[data-state='leaving'] { transform: translateY(-5px); }
.cf-win[data-state='waiting'] { transform: translateY(5px); }
@media (prefers-reduced-motion: reduce) {
  .cf-win {
    transform: none !important;
    transition: opacity 120ms linear, color 150ms linear;
  }
}
