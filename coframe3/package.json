{
  "name": "coframe3",
  "version": "1.0.0",
  "private": true,
  "description": "Pixel-faithful Next.js + TypeScript replica of the coframe.com homepage",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape": "node scripts/scrape.mjs",
    "extras": "node scripts/fetch-extras.mjs",
    "codegen": "node scripts/codegen.mjs",
    "verify": "node scripts/viewport-check.mjs",
    "verify:live": "node scripts/viewport-check.mjs --live",
    "verify:shots": "node scripts/viewport-check.mjs --shots"
  },
  "dependencies": {
    "@rive-app/webgl2": "2.35.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "swiper": "11.2.6"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.3",
    "@vitejs/plugin-react": "4.4.1",
    "jsdom": "26.1.0",
    "parse5": "7.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "5.8.3",
    "vitest": "3.1.2"
  }
}
